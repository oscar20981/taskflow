# Copia este archivo como .env (cp .env.example .env). Docker Compose lo lee automáticamente.
# Todas las variables tienen un valor por defecto, así que el proyecto también funciona sin .env.

# Frontend (URLs que usa el NAVEGADOR; se incorporan al compilar la imagen)
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Backend
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
CACHE_TTL_SECONDS=30

# Worker (pausa que simula el procesamiento, en milisegundos)
WORKER_PROCESSING_DELAY_MS=2000
